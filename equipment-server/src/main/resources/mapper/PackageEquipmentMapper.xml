<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.power.mapper.PackageEquipmentMapper">

    <select id="getPackageIdByEquipmentIds">
        select package_id from package_equipment where equipment_id in
        <foreach collection="equipmentIds" item="equipmentId" open="(" separator="," close=")">
            #{equipmentId}
        </foreach>
    </select>

    <insert id="insertBatch" parameterType="list">
        insert into package_equipment
        (package_id,equipment_id,name,price,quantity)
        values
        <foreach collection="packageEquipments" item="sd" separator=",">
            (#{sd.packageId},#{sd.equipmentId},#{sd.name},#{sd.price},#{sd.quantity})
        </foreach>
    </insert>

</mapper>
